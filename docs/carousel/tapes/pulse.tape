# boost carousel — Team & Collaboration flagship: pulse
# regenerate (from repo root): vhs docs/carousel/tapes/pulse.tape

Output docs/carousel/gifs/pulse.gif
Set FontSize 15
Set Width 940
Set Height 540
Set Padding 12
Set TypingSpeed 35ms
Set Theme "Dracula"

Hide
Type "export HOME=$(mktemp -d) COLORTERM=truecolor PATH=$PWD:$PATH; export BOOST_NO_AI=1 BOOST_ASSUME_YES=1; python3 tests/make_fixture.py /tmp/boost-carousel-team >/dev/null 2>&1; boost tap /tmp/boost-carousel-team >/dev/null 2>&1; boost install brainstorming >/dev/null 2>&1; boost install commit-messages >/dev/null 2>&1; clear"
Enter
Show

Type "boost pulse"
Enter
Sleep 4s
