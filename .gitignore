# BMAD Method — generated artifacts (provisioned via `boost bmad`, not source)
_bmad/
_bmad-output/

# Dogfooding boost inside boost's own checkout. Running `boost install --local`
# here to test a change materializes into exactly the layout the CLI is
# documented to produce — a project lock, one dotdir per agent target, and a
# context file per agent with no rules dir — and every one of them lands
# untracked in this repo. That made a dirty working tree the normal state and
# put generated content one `git add -A` away from being committed as source.
#
# The canonical store lives under $HOME, so nothing here is the store itself;
# these are only this repo's project-scoped copies.
.boost/
.claude/skills/
.claude/worktrees/
.cursor/
.gemini/
.windsurf/

# Per-agent context files boost writes for a project-scoped rule
# (rules.CONTEXT_FILES). CLAUDE.md is *source* and stays tracked; these two are
# generated — GEMINI.md carries `boost:rule:*` markers, and CLAUDE.local.md is
# the local-scope half that was never meant to be shared.
/GEMINI.md
/CLAUDE.local.md

# Workflows materialize into .claude/commands/, which is also where this repo
# keeps its own committed slash commands (roadmap-loop.md), so the directory
# cannot be ignored wholesale. Named entries are the honest fix until the two
# have somewhere separate to live; add a line when you install another.
.claude/commands/ship-it.md

# mutmut mutation-testing workspace (regenerated by `mutmut run`)
mutants/

# sandboxed boost home for the Tier 1 eval corpus (`make eval` taps here)
.eval-home/

# `make evals` output. The generated corpus and index live in the system temp
# dir (see evals/run_evals.py), so only the per-run scores land here; the
# committed evals/baseline.json is what regressions are measured against.
evals/results.json
tests/visual/out/

# Installed npm trees, never the lockfiles that describe them. Both
# package-lock.json files ARE committed on purpose: package.json pins only the
# direct dependencies, so without the lock every transitive package resolves
# fresh at install time. The lock carries an integrity hash for all 181 (root)
# and 81 (tests/visual) packages, which is what makes `npm ci` reproducible and
# what OpenSSF Scorecard's Pinned-Dependencies check asks for.
node_modules/

# macOS Finder metadata. Not ignored for years, so it surfaced as an
# untracked file in every `git status` on a Mac and was one more line of noise
# to read past before spotting real uncommitted work.
.DS_Store

# Serena MCP server project state (symbol cache, its own memories, local
# config). Written into the repo root by the language-server tooling, not by
# boost, and specific to one developer's machine.
.serena/

# A SQLite artifact from a tool that passed ":memory:" as a path rather than as
# the in-memory sentinel. Junk either way, and on Windows it is worse than junk:
# a colon cannot appear in a filename there, so committing it makes `git
# checkout` fail with exit 128 and every Windows CI job dies before it runs a
# single test.
:memory:*
